import { WebSocket } from "ws";
import { IncomingMessage } from "http";
import { aiService } from "../../services/ai.service.js";
import { redisService } from "../../services/redis.service.js";
import { activeCalls } from "../v1/voice.controller.js";
import { logger } from "../../utils/logger.js"; // NEW

export const activeWidgets = new Map<string, WebSocket>();

export const widgetController = {
  handleClientStream(ws: WebSocket, req: IncomingMessage) {
    const url = new URL(req.url || "", `http://${req.headers.host}`);
    const sessionId = url.searchParams.get("sessionId");
    const orgId = url.searchParams.get("orgId");

    if (!sessionId || !orgId) {
      logger.warn("Widget connection rejected: Session ID or Org ID missing.");
      ws.close(1008, "Session ID and Org ID required");
      return;
    }

    logger.info(`Frontend UI connected for Session: ${sessionId}`);
    activeWidgets.set(sessionId, ws);

    ws.on("message", async (data: Buffer) => {
      try {
        const payload = JSON.parse(data.toString());
        
        if (payload.action === "INCOMING_CHAT") {
          const message = payload.message || "";
          let finalUserMessage = message;

          if (payload.image && payload.mimeType) {
            logger.info(`Image uploaded over WS for Session: ${sessionId}`);
            const visionAnalysis = await aiService.analyzeImage(payload.image, payload.mimeType);
            finalUserMessage = `${message}\n\n[SYSTEM NOTE: The user uploaded an image. Vision Analysis: ${visionAnalysis}]`.trim();
          }

          if (!finalUserMessage) return;

          let chatHistory = await redisService.getSessionHistory(sessionId);
          chatHistory = chatHistory.filter((msg: any) => msg.role !== "system");

          const currentDateTime = new Date().toLocaleString('en-US', { 
            timeZone: 'Asia/Kolkata',
            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
            hour: '2-digit', minute: '2-digit', hour12: true
          });

         const systemPrompt = `
          You are the AI dispatch assistant for a plumbing company. 
          Current Time: ${currentDateTime}

          STRICT BOUNDARIES & ABUSE PREVENTION:
          - You ONLY handle plumbing issues and appointments. NEVER answer general knowledge questions.
          - TWO-STRIKE RULE: If the user is irrelevant TWO TIMES IN A ROW, immediately say: "Since I cannot assist with this, I will hang up now. Have a great day."

          CRITICAL TOOL USAGE RULES (NEVER HALLUCINATE):
          - You CANNOT see calendars, open forms, or book appointments by yourself. YOU MUST USE YOUR TOOLS.
          - NEVER invent or simulate available time slots. You MUST call the 'checkCalendarAvailability' tool.
          - NEVER pretend to collect details. You MUST call the 'requestCustomerDetails' tool.
          - NEVER confirm a booking without calling the 'bookAppointment' tool.
          - When you need to use a tool, output the tool call AND STOP. Do not answer on behalf of the tool.

          STATE MACHINE WORKFLOW - Follow strictly step-by-step:

          [STATE 1: ISSUE GATHERING]
          - Introduce yourself and ask what plumbing issue they are facing.
          - If the user explicitly says they want to upload an image: trigger the 'requestImageUpload' tool immediately and STOP. Wait for the analysis.
          - If they describe it verbally, ask: "Would you like to upload a photo of the issue?" 
             - If YES: trigger the 'requestImageUpload' tool and STOP.
             - If NO: accept their explanation and move to STATE 2.

          [STATE 2: DATE SELECTION & CALENDAR CHECK]
          - Ask what date they want the plumber to visit. WAIT for their response.
          - ONLY AFTER they provide a date, you MUST call the 'checkCalendarAvailability' tool. Use EXACT local IST format (YYYY-MM-DDTHH:mm:00).
          - DO NOT invent slots. WAIT for the tool to return the real slots.

          [STATE 3: SLOT SELECTION]
          - Present the open slots returned by the tool and ask them to pick one.
          - BACKWARD NAVIGATION: The user CAN go back to State 2 to pick a different date.

          [STATE 4: CUSTOMER DETAILS (TOOL CALL REQUIRED)]
          - Once a slot is picked, you MUST call the 'requestCustomerDetails' tool. 
          - Tell the user: "I am opening a form on your screen for your details."
          - STOP AND WAIT. Do not proceed until the user submits the form.
          - POPUP RECOVERY: If the user says they closed or missed the form, call the 'requestCustomerDetails' tool again.

          [STATE 5: BOOKING & PAYMENT PENDING (CRITICAL LOCK)]
          - Once you have the details, you MUST call the 'bookAppointment' tool.
          - The tool will return a tracking token. MEMORIZE THIS TOKEN.
          - Tell the user: "I have reserved your slot. Please complete the advance payment on your screen."
          - DO NOT give the tracking token yet. DO NOT confirm the booking.
          - NAVIGATION LOCK: The user CANNOT go back to previous steps anymore. 

          [STATE 6: PAYMENT VERIFICATION (ZERO TRUST)]
          - POPUP RECOVERY: If the user says they closed, missed, cannot see the screen, or asks where the payment is, YOU MUST call the 'resendPaymentPopup' tool immediately.
          - ZERO TRUST RULE: For ALL OTHER replies (especially if they say "done" or "paid"), reply strictly: "Your payment is not completed. Kindly complete that on your screen before proceeding further."
          - YOU MUST WAIT for a hidden system message that says exactly: "[SYSTEM_PAYMENT_SUCCESSFUL]". 
          - ONLY when you receive the exact text "[SYSTEM_PAYMENT_SUCCESSFUL]", move to STATE 7.

          [STATE 7: POST-PAYMENT WRAP-UP]
          - Confirm the appointment and provide the tracking token. 
          - Ask: "Is there anything else I can help you with?"
          - IF YES: Provide details again (allow ONLY 1 time), or ask them to start a new session for a new booking.
          - IF NO: Say "It was a pleasure assisting you. Have a great day!" (Triggering the hang-up).
          `;

          chatHistory.unshift({ role: "system", content: systemPrompt });
          chatHistory.push({ role: "user", content: finalUserMessage });

          const aiResponse = await aiService.generateResponse(chatHistory, orgId, sessionId);
          await redisService.saveSessionHistory(sessionId, aiResponse.updatedMessages);
          const replyText = aiResponse.reply.toLowerCase();
          const shouldEndChat = replyText.includes("goodbye") || replyText.includes("have a great day");
          const activeVoiceSocket = activeCalls.get(sessionId);
          if (shouldEndChat && !activeVoiceSocket) {
             setTimeout(() => {
                if (ws.readyState === WebSocket.OPEN) {
                   ws.send(JSON.stringify({ action: "END_CHAT" }));
                   logger.info(`Delayed END_CHAT signal sent for session ${sessionId}`);
                }
             }, 3000); // 3 seconds to read the goodbye message
          }
          /* if (shouldEndChat) {
             // Push a custom signal to tell the frontend to close the chat
             aiResponse.pendingSignals.push({ action: "END_CHAT" });
          } */
          if (activeVoiceSocket) {
            logger.info(`UI input received during active voice call. Interrupting Retell for session ${sessionId}...`);
            
            const cleanReply = aiResponse.reply.replace(/<function[\s\S]*?<\/function>/ig, '').trim();
            
            activeVoiceSocket.ws.send(JSON.stringify({
              response_type: "agent_interrupt",
              interrupt_id: Math.floor(Math.random() * 900000) + 100000,
              content: cleanReply, 
              content_complete: true,
              no_interruption_allowed: false
            }));

            ws.send(JSON.stringify({ action: "CHAT_REPLY", reply: cleanReply }));
            aiResponse.pendingSignals.forEach((signal: any) => {
              ws.send(JSON.stringify(signal));
            });
            return; 
          }

          if (aiResponse.reply) {
            const cleanReply = aiResponse.reply.replace(/<function[\s\S]*?<\/function>/ig, '').trim();
            if (cleanReply) {
              ws.send(JSON.stringify({ action: "CHAT_REPLY", reply: cleanReply }));
            }
          }
          aiResponse.pendingSignals.forEach((signal: any) => {
             ws.send(JSON.stringify(signal));
          });
        }
      } catch (error) {
        logger.error(`WebSocket message error for session ${sessionId}:`, error);
        ws.send(JSON.stringify({ action: "CHAT_REPLY", reply: "Sorry, I encountered an error processing your message." }));
      }
    });

    ws.on("close", () => {
      logger.info(`Frontend UI disconnected for Session: ${sessionId}`);
      activeWidgets.delete(sessionId);
    });
  },
  sendSignal(sessionId: string, payload: any) {
    const ws = activeWidgets.get(sessionId);
    if (ws && ws.readyState === WebSocket.OPEN) {
      ws.send(JSON.stringify(payload));
      logger.info(`Signal sent to ${sessionId}: ${payload.action}`);
    } else {
      logger.warn(`Could not send signal to ${sessionId}. UI is not connected.`);
    }
  }
  /* sendSignal(sessionId: string, payload: { action: string; data?: any }) {
    const ws = activeWidgets.get(sessionId);
    if (ws && ws.readyState === WebSocket.OPEN) {
      ws.send(JSON.stringify(payload));
      logger.info(`Signal sent to ${sessionId}: ${payload.action}`);
    } else {
      logger.warn(`Could not send signal to ${sessionId}. UI is not connected.`);
    }
  } */
};